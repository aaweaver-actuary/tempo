FROM python:3.12-slim

WORKDIR /work
COPY backend/requirements.txt ./requirements.txt
COPY services/learning/remediation /services/learning/remediation
COPY contracts/game-evidence /contracts/game-evidence
RUN pip install --no-cache-dir -r requirements.txt /services/learning/remediation /contracts/game-evidence
COPY backend/migrations ./backend/migrations
COPY backend/app/__init__.py backend/app/schema_version.py ./backend/app/
COPY backend/app/services/tactic_capture_migration.py ./backend/app/services/
COPY scripts ./scripts

ENTRYPOINT ["python"]
