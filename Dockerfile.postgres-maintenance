FROM python:3.12-slim

WORKDIR /work
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY database/tempo_storage/__init__.py ./database/tempo_storage/
COPY database/tempo_storage/ddl ./database/tempo_storage/ddl
COPY database/tooling ./database/tooling
COPY scripts ./scripts
ENV PYTHONPATH=/work/database

ENTRYPOINT ["python"]
