{
  "$id": "https://tempo.invalid/contracts/learning-transfer/v1/VerificationReceipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "BLOCK"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_generation": {
      "minLength": 1,
      "title": "Target Generation",
      "type": "string"
    },
    "transfer_id": {
      "minLength": 1,
      "title": "Transfer Id",
      "type": "string"
    },
    "verifier_evidence": {
      "minLength": 1,
      "title": "Verifier Evidence",
      "type": "string"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "transfer_id",
    "manifest_digest",
    "target_generation",
    "verifier_evidence",
    "status",
    "blockers"
  ],
  "title": "VerificationReceipt",
  "type": "object"
}
