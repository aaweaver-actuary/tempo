{
  "$id": "https://tempo.invalid/contracts/learning-transfer/v1/ActivationReceipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_id": {
      "minLength": 1,
      "title": "Activation Id",
      "type": "string"
    },
    "fence_id": {
      "minLength": 1,
      "title": "Fence Id",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "target_acceptance": {
      "enum": [
        "none",
        "accepted",
        "uncertain"
      ],
      "title": "Target Acceptance",
      "type": "string"
    },
    "target_authority": {
      "minLength": 1,
      "title": "Target Authority",
      "type": "string"
    },
    "target_generation": {
      "minLength": 1,
      "title": "Target Generation",
      "type": "string"
    },
    "transfer_id": {
      "minLength": 1,
      "title": "Transfer Id",
      "type": "string"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "transfer_id",
    "manifest_digest",
    "fence_id",
    "target_generation",
    "target_authority",
    "activation_id",
    "target_acceptance"
  ],
  "title": "ActivationReceipt",
  "type": "object"
}
