{
  "$defs": {
    "CaptureInventory": {
      "additionalProperties": false,
      "properties": {
        "completeness_evidence": {
          "minLength": 1,
          "title": "Completeness Evidence",
          "type": "string"
        },
        "expected_count": {
          "minimum": 0,
          "title": "Expected Count",
          "type": "integer"
        },
        "expected_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Expected Digest",
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/StoreShape"
        }
      },
      "required": [
        "shape",
        "expected_count",
        "expected_digest",
        "completeness_evidence"
      ],
      "title": "CaptureInventory",
      "type": "object"
    },
    "KeyPart": {
      "additionalProperties": false,
      "properties": {
        "codec": {
          "minLength": 1,
          "title": "Codec",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "codec",
        "value"
      ],
      "title": "KeyPart",
      "type": "object"
    },
    "SourceKey": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "primary_key": {
          "items": {
            "$ref": "#/$defs/KeyPart"
          },
          "minItems": 1,
          "title": "Primary Key",
          "type": "array"
        },
        "store": {
          "minLength": 1,
          "title": "Store",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "store",
        "primary_key"
      ],
      "title": "SourceKey",
      "type": "object"
    },
    "StateFact": {
      "additionalProperties": false,
      "properties": {
        "archive_readback": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archive Readback"
        },
        "blocker": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocker"
        },
        "codec": {
          "minLength": 1,
          "title": "Codec",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "EXACT",
            "TRANSLATE",
            "ARCHIVE",
            "BLOCK"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "family": {
          "enum": [
            "content",
            "cards_history",
            "position",
            "issued",
            "queue",
            "games",
            "tactics",
            "browser"
          ],
          "title": "Family",
          "type": "string"
        },
        "original_base64": {
          "title": "Original Base64",
          "type": "string"
        },
        "original_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Original Digest",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/SourceKey"
          },
          "title": "References",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SourceKey"
        },
        "target_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_owner": {
          "minLength": 1,
          "title": "Target Owner",
          "type": "string"
        },
        "translation_proof": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Translation Proof"
        }
      },
      "required": [
        "family",
        "source",
        "codec",
        "original_base64",
        "original_digest",
        "references",
        "required",
        "disposition",
        "target_owner",
        "target_key",
        "translation_proof",
        "archive_readback",
        "blocker"
      ],
      "title": "StateFact",
      "type": "object"
    },
    "StoreShape": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "primary_key": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Primary Key",
          "type": "array"
        },
        "schema_evidence": {
          "minLength": 1,
          "title": "Schema Evidence",
          "type": "string"
        },
        "store": {
          "minLength": 1,
          "title": "Store",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "store",
        "primary_key",
        "schema_evidence"
      ],
      "title": "StoreShape",
      "type": "object"
    }
  },
  "$id": "https://tempo.invalid/contracts/learning-transfer/v1/SourceManifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capture": {
      "enum": [
        "warm",
        "final_fenced"
      ],
      "title": "Capture",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/StateFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "family_evidence": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "enum": [
              "content",
              "cards_history",
              "position",
              "issued",
              "queue",
              "games",
              "tactics",
              "browser"
            ],
            "type": "string"
          },
          {
            "minLength": 1,
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Family Evidence",
      "type": "array"
    },
    "family_inventory": {
      "items": {
        "enum": [
          "content",
          "cards_history",
          "position",
          "issued",
          "queue",
          "games",
          "tactics",
          "browser"
        ],
        "type": "string"
      },
      "title": "Family Inventory",
      "type": "array"
    },
    "fence_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fence Id"
    },
    "scheduler_identity": {
      "minLength": 1,
      "title": "Scheduler Identity",
      "type": "string"
    },
    "scope": {
      "enum": [
        "representative",
        "complete"
      ],
      "title": "Scope",
      "type": "string"
    },
    "source_authority": {
      "minLength": 1,
      "title": "Source Authority",
      "type": "string"
    },
    "source_inventory": {
      "items": {
        "$ref": "#/$defs/CaptureInventory"
      },
      "minItems": 1,
      "title": "Source Inventory",
      "type": "array"
    },
    "source_schema": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Schema",
      "type": "string"
    },
    "source_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Sha",
      "type": "string"
    },
    "source_watermark": {
      "minLength": 1,
      "title": "Source Watermark",
      "type": "string"
    },
    "study_timezone": {
      "minLength": 1,
      "title": "Study Timezone",
      "type": "string"
    },
    "target_authority": {
      "minLength": 1,
      "title": "Target Authority",
      "type": "string"
    },
    "target_schema": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Target Schema",
      "type": "string"
    },
    "target_shapes": {
      "items": {
        "$ref": "#/$defs/StoreShape"
      },
      "minItems": 1,
      "title": "Target Shapes",
      "type": "array"
    },
    "transfer_id": {
      "minLength": 1,
      "title": "Transfer Id",
      "type": "string"
    },
    "unresolved": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved",
      "type": "array"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "transfer_id",
    "source_authority",
    "target_authority",
    "source_sha",
    "source_schema",
    "target_schema",
    "source_watermark",
    "scope",
    "source_inventory",
    "target_shapes",
    "family_evidence",
    "capture",
    "fence_id",
    "study_timezone",
    "scheduler_identity",
    "family_inventory",
    "unresolved",
    "facts"
  ],
  "title": "SourceManifest",
  "type": "object"
}
