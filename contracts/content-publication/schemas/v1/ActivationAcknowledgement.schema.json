{
  "$id": "https://tempo.invalid/contracts/content-publication/v1/ActivationAcknowledgement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Activation Id",
      "type": "string"
    },
    "activation_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Activation Revision",
      "type": "integer"
    },
    "contract_version": {
      "const": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "publication_generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Publication Generation",
      "type": "integer"
    },
    "publication_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "status": {
      "enum": [
        "accepted_pending",
        "activated",
        "rejected",
        "retryable_failure",
        "stale_generation"
      ],
      "title": "Status",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "workspace_id",
    "activation_id",
    "publication_id",
    "publication_generation",
    "activation_revision",
    "status",
    "reason"
  ],
  "title": "ActivationAcknowledgement",
  "type": "object"
}
