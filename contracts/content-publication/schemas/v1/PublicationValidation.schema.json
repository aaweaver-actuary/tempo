{
  "$id": "https://tempo.invalid/contracts/content-publication/v1/PublicationValidation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "errors": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "publication_generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Publication Generation",
      "type": "integer"
    },
    "publication_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "validated",
        "rejected",
        "retryable_failure"
      ],
      "title": "Status",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "workspace_id",
    "publication_id",
    "publication_generation",
    "status",
    "errors"
  ],
  "title": "PublicationValidation",
  "type": "object"
}
