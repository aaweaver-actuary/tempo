postgres-1  | 2026-10-12 17:24:08.978 UTC [1252] STATEMENT:  WITH root_candidates AS (
postgres-1  | 	    SELECT candidate.id FROM opening_graph_publications publication
postgres-1  | 	    CROSS JOIN LATERAL (
postgres-1  | 	        SELECT DISTINCT card.id FROM opening_graph_steps step
postgres-1  | 	        JOIN cards card ON card.id=step.card_id
postgres-1  | 	        WHERE step.repertoire_id=publication.repertoire_id
postgres-1  | 	          AND step.generation=publication.generation AND step.parent_card_id IS NULL
postgres-1  | 	          AND card.content_type='opening' AND card.state='locked' AND card.archived=0
postgres-1  | 	          AND card.id>$1 ORDER BY card.id NULLS FIRST LIMIT $2
postgres-1  | 	    ) candidate
web-1       | 172.18.0.1 - - [12/Oct/2026:17:24:52 +0000] "GET / HTTP/1.1" 200 1470 "-" "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36" "-"
postgres-1  | 	), practiced_parent_candidates AS (
postgres-1  | 	    SELECT candidate.id FROM cards parent
postgres-1  | 	    CROSS JOIN LATERAL (
postgres-1  | 	        SELECT DISTINCT card.id FROM opening_graph_steps step
postgres-1  | 	        JOIN opening_graph_publications publication ON publication.repertoire_id=step.repertoire_id
postgres-1  | 	          AND publication.generation=step.generation
postgres-1  | 	        JOIN cards card ON card.id=step.card_id
postgres-1  | 	        WHERE step.parent_card_id=parent.id AND card.content_type='opening'
postgres-1  | 	          AND card.state='locked' AND card.archived=0 AND card.id>$3
postgres-1  | 	        ORDER BY card.id NULLS FIRST LIMIT $4
postgres-1  | 	    ) candidate WHERE EXISTS(
postgres-1  | 	    SELECT 1 FROM reviews parent_review
postgres-1  | 	    WHERE parent_review.card_id=parent.id AND parent_review.source_kind='study'
postgres-1  | 	      AND parent_review.invalidated_at IS NULL
postgres-1  | 	)
postgres-1  | 	) SELECT id FROM root_candidates UNION SELECT id FROM practiced_parent_candidates
postgres-1  | 	ORDER BY id NULLS FIRST LIMIT $5
