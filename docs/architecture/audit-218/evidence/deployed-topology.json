[
  {
    "service": "postgres-backup",
    "container_id": "18d25e613b1e27c4eb9ba2776578487505a0d5743c83d2d2938d376c0f1e3ce9",
    "image_id": "sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336",
    "command": [
      "while :; do\n  stamp=$(date -u +%Y%m%dT%H%M%SZ)\n  partial=/backups/tempo-${stamp}.dump.partial\n  finished=/backups/tempo-${stamp}.dump\n  pg_dump -h postgres -U tempo -d tempo -Fc -f \"${partial}\"\n  pg_restore -l \"${partial}\" >/dev/null\n  mv \"${partial}\" \"${finished}\"\n  sha256sum \"${finished}\" > \"${finished}.sha256\"\n  find /backups -name 'tempo-*.dump' -mtime +30 -delete\n  find /backups -name 'tempo-*.dump.sha256' -mtime +30 -delete\n  sleep 86400\ndone\n"
    ],
    "cpu_nanos": 0,
    "memory_bytes": 0,
    "pool_size_override": [],
    "revision": null
  },
