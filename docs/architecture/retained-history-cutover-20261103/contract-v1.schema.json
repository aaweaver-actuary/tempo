        "translation_proof": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Translation Proof"
        },
        "archive_readback": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archive Readback"
        },
        "blocker": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocker"
        }
      },
      "required": [
        "family",
        "source",
        "codec",
        "original_base64",
        "original_digest",
        "references",
        "required",
        "disposition",
        "target_owner",
        "target_key",
        "translation_proof",
        "archive_readback",
        "blocker"
      ],
      "title": "StateFact",
      "type": "object"
