{
  "$defs": {
    "ActivationReceipt": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "transfer_id": {
          "minLength": 1,
          "title": "Transfer Id",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "fence_id": {
          "minLength": 1,
          "title": "Fence Id",
          "type": "string"
        },
        "target_generation": {
          "minLength": 1,
          "title": "Target Generation",
          "type": "string"
        },
        "target_authority": {
          "minLength": 1,
          "title": "Target Authority",
          "type": "string"
        },
        "activation_id": {
          "minLength": 1,
          "title": "Activation Id",
          "type": "string"
        },
        "target_acceptance": {
          "enum": [
            "none",
            "accepted",
            "uncertain"
          ],
          "title": "Target Acceptance",
          "type": "string"
        }
      },
      "required": [
        "version",
        "transfer_id",
        "manifest_digest",
        "fence_id",
        "target_generation",
        "target_authority",
        "activation_id",
        "target_acceptance"
      ],
      "title": "ActivationReceipt",
      "type": "object"
    },
    "CaptureInventory": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "$ref": "#/$defs/StoreShape"
        },
        "expected_count": {
          "minimum": 0,
          "title": "Expected Count",
          "type": "integer"
        },
        "expected_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Expected Digest",
          "type": "string"
        },
        "completeness_evidence": {
          "minLength": 1,
          "title": "Completeness Evidence",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "expected_count",
        "expected_digest",
        "completeness_evidence"
      ],
      "title": "CaptureInventory",
      "type": "object"
    },
    "FencingProof": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "transfer_id": {
          "minLength": 1,
          "title": "Transfer Id",
          "type": "string"
        },
        "fence_id": {
          "minLength": 1,
          "title": "Fence Id",
          "type": "string"
        },
        "source_authority": {
          "minLength": 1,
          "title": "Source Authority",
          "type": "string"
        },
        "target_authority": {
          "minLength": 1,
          "title": "Target Authority",
          "type": "string"
        },
        "source_watermark": {
          "minLength": 1,
          "title": "Source Watermark",
          "type": "string"
        },
        "denied_writer_inventory_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Denied Writer Inventory Digest",
          "type": "string"
        },
        "stale_session_denial": {
          "minLength": 1,
          "title": "Stale Session Denial",
          "type": "string"
        },
        "credential_denial": {
          "minLength": 1,
          "title": "Credential Denial",
          "type": "string"
        },
        "restart_denial": {
          "minLength": 1,
          "title": "Restart Denial",
          "type": "string"
        },
        "lock_identity": {
          "minLength": 1,
          "title": "Lock Identity",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "version",
        "transfer_id",
        "fence_id",
        "source_authority",
        "target_authority",
        "source_watermark",
        "denied_writer_inventory_digest",
        "stale_session_denial",
        "credential_denial",
        "restart_denial",
        "lock_identity",
        "evidence"
      ],
      "title": "FencingProof",
      "type": "object"
    },
    "KeyPart": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "codec": {
          "minLength": 1,
          "title": "Codec",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "codec",
        "value"
      ],
      "title": "KeyPart",
      "type": "object"
    },
    "RuntimeProof": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "activation_id": {
          "minLength": 1,
          "title": "Activation Id",
          "type": "string"
        },
        "source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Sha",
          "type": "string"
        },
        "images": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Images",
          "type": "array"
        },
        "schema_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Identity",
          "type": "string"
        },
        "workspace": {
          "minLength": 1,
          "title": "Workspace",
          "type": "string"
        },
        "worker_identity": {
          "minLength": 1,
          "title": "Worker Identity",
          "type": "string"
        },
        "modes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Modes",
          "type": "array"
        },
        "scope": {
          "enum": [
            "disposable",
            "installed"
          ],
          "title": "Scope",
          "type": "string"
        },
        "fixture_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Fixture Evidence",
          "type": "array"
        },
        "one_writer_evidence": {
          "minLength": 1,
          "title": "One Writer Evidence",
          "type": "string"
        },
        "saved_review_playable_next_evidence": {
          "minLength": 1,
          "title": "Saved Review Playable Next Evidence",
          "type": "string"
        }
      },
      "required": [
        "version",
        "activation_id",
        "source_sha",
        "images",
        "schema_identity",
        "workspace",
        "worker_identity",
        "modes",
        "scope",
        "fixture_evidence",
        "one_writer_evidence",
        "saved_review_playable_next_evidence"
      ],
      "title": "RuntimeProof",
      "type": "object"
    },
    "SourceKey": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "store": {
          "minLength": 1,
          "title": "Store",
          "type": "string"
        },
        "primary_key": {
          "items": {
            "$ref": "#/$defs/KeyPart"
          },
          "minItems": 1,
          "title": "Primary Key",
          "type": "array"
        }
      },
      "required": [
        "authority",
        "store",
        "primary_key"
      ],
      "title": "SourceKey",
      "type": "object"
    },
    "SourceManifest": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "transfer_id": {
          "minLength": 1,
