    "StateFact": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "content",
            "cards_history",
            "position",
            "issued",
            "queue",
            "games",
            "tactics",
            "browser"
          ],
          "title": "Family",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceKey"
        },
        "codec": {
          "minLength": 1,
          "title": "Codec",
          "type": "string"
        },
        "original_base64": {
          "title": "Original Base64",
          "type": "string"
        },
        "original_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Original Digest",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/SourceKey"
          },
          "title": "References",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "EXACT",
            "TRANSLATE",
            "ARCHIVE",
            "BLOCK"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "target_owner": {
          "minLength": 1,
