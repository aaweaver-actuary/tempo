          "minLength": 1,
          "title": "Source Authority",
          "type": "string"
        },
        "target_authority": {
          "minLength": 1,
          "title": "Target Authority",
          "type": "string"
        },
        "source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Sha",
          "type": "string"
        },
        "source_schema": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Schema",
          "type": "string"
        },
        "target_schema": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Schema",
          "type": "string"
        },
        "source_watermark": {
          "minLength": 1,
          "title": "Source Watermark",
          "type": "string"
        },
        "scope": {
          "enum": [
            "representative",
            "complete"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source_inventory": {
          "items": {
            "$ref": "#/$defs/CaptureInventory"
          },
          "minItems": 1,
          "title": "Source Inventory",
          "type": "array"
        },
        "target_shapes": {
          "items": {
            "$ref": "#/$defs/StoreShape"
          },
          "minItems": 1,
          "title": "Target Shapes",
          "type": "array"
        },
        "family_evidence": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "enum": [
                  "content",
                  "cards_history",
                  "position",
                  "issued",
                  "queue",
                  "games",
                  "tactics",
                  "browser"
                ],
                "type": "string"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Family Evidence",
          "type": "array"
        },
        "capture": {
          "enum": [
            "warm",
            "final_fenced"
          ],
          "title": "Capture",
          "type": "string"
        },
        "fence_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fence Id"
        },
        "study_timezone": {
          "minLength": 1,
          "title": "Study Timezone",
          "type": "string"
        },
        "scheduler_identity": {
          "minLength": 1,
          "title": "Scheduler Identity",
          "type": "string"
        },
        "family_inventory": {
          "items": {
            "enum": [
              "content",
              "cards_history",
              "position",
              "issued",
              "queue",
              "games",
              "tactics",
              "browser"
            ],
            "type": "string"
          },
          "title": "Family Inventory",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/StateFact"
          },
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "version",
        "transfer_id",
        "source_authority",
        "target_authority",
        "source_sha",
        "source_schema",
        "target_schema",
        "source_watermark",
        "scope",
        "source_inventory",
        "target_shapes",
        "family_evidence",
        "capture",
        "fence_id",
        "study_timezone",
        "scheduler_identity",
        "family_inventory",
        "unresolved",
        "facts"
      ],
      "title": "SourceManifest",
      "type": "object"
    },
    "StageReceipt": {
