FROM rust:1.91-slim AS core
RUN rustup target add wasm32-unknown-unknown && cargo install wasm-pack --version 0.13.1 --locked
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY tempo-core ./tempo-core
COPY tests/fixtures ./tests/fixtures
RUN wasm-pack build tempo-core --target web --out-dir ../public/tempo-core --release

FROM node:22-slim AS web
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/chess-line/package.json ./packages/chess-line/package.json
COPY database/browser-intents/package.json ./database/browser-intents/package.json
COPY packages/study-session/package.json ./packages/study-session/package.json
RUN npm ci
COPY static ./static
COPY app ./app
COPY database/browser ./database/browser
COPY database/browser-intents ./database/browser-intents
COPY packages/chess-line ./packages/chess-line
COPY packages/study-session ./packages/study-session
COPY packages/board-ui ./packages/board-ui
COPY scripts/study-composition.ts scripts/offline-shell-assets.ts ./scripts/
COPY tsconfig.json module-resolution.ts vite.static.config.ts ./
COPY public ./public
COPY --from=core /app/public/tempo-core ./public/tempo-core
RUN npm run build:local

FROM nginx:1.28-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web /app/local-dist /usr/share/nginx/html
RUN chmod -R a+rX /usr/share/nginx/html
EXPOSE 80
