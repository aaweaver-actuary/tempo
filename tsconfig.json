{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@tempo/board-ui": ["./packages/board-ui/src/index.ts"],
      "@tempo/board-ui/interfaces": ["./packages/board-ui/src/interfaces/index.ts"],
      "@tempo/chess-line/interfaces": ["./packages/chess-line/src/interfaces/index.ts"],
      "@tempo/study-session/interfaces": ["./packages/study-session/src/interfaces/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "local-dist", "pages-dist", "public/tempo-core", "static-dist", "contracts/consumer-examples/**"]
}
