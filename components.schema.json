{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "maintainer",
          "status",
          "root",
          "publicExports",
          "dependencies",
          "buildInputs",
          "buildCommand",
          "artifact",
          "tests",
          "toolchain",
          "dataOwnership"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "app",
              "service",
              "worker",
              "library",
              "contract",
              "tool",
              "integration"
            ]
          },
          "maintainer": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "implemented"
            ]
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "publicExports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publicSubpaths": { "type": "array", "items": { "type": "string" } },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "buildInputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "buildCommand": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact": {
            "type": [
              "object",
              "null"
            ]
          },
          "tests": {
            "type": "array"
          },
          "toolchain": {
            "type": "object"
          },
          "dataOwnership": {
            "type": "object"
          },
          "catalog": {
            "type": "string",
            "minLength": 1
          },
          "testInventory": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "suites": {
      "type": "array"
    }
  }
}
