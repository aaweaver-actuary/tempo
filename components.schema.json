{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "maintainer",
          "status",
          "root",
          "publicExports",
          "dependencies",
          "buildInputs",
          "buildCommand",
          "artifact",
          "tests",
          "toolchain",
          "dataOwnership"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "app",
              "service",
              "worker",
              "library",
              "contract",
              "tool",
              "integration"
            ]
          },
          "maintainer": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "implemented",
              "mapped"
            ]
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "publicExports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "buildInputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "buildCommand": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact": {
            "type": [
              "object",
              "null"
            ]
          },
          "tests": {
            "type": "array"
          },
          "toolchain": {
            "type": "object"
          },
          "dataOwnership": {
            "type": "object"
          },
          "catalog": {
            "type": "string",
            "minLength": 1
          },
          "testInventory": {
            "type": "string",
            "minLength": 1
          },
          "qualification": {
            "type": "string",
            "enum": [
              "board-ui",
              "evidence-math"
            ]
          },
          "peerDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publicSubpaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publicModules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownershipRole": {
            "type": "string",
            "minLength": 1
          },
          "dependencyNotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "censusScope": {
            "type": "string",
            "enum": [
              "retained",
              "review",
              "durable",
              "calendar",
              "prefix_split",
              "readiness",
              "settings",
              "teaching",
              "annotation",
              "activity",
              "integrity",
              "opening_graph",
              "pgn_import",
              "card_deletion",
              "canonical_prefix",
              "repertoire_changes",
              "card_branch_edits",
              "repertoire_controls",
              "tactics",
              "queue_commands",
              "queue_order",
              "queue_application",
              "queue_refresh",
              "study_attempt",
              "study_grading",
              "repertoire_conflicts",
              "frozen_order",
              "queue_attempt_origin",
              "opening_evidence",
              "position_first_response",
              "position_grade_effect",
              "position_plan",
              "position_source",
              "captured_tactic",
              "chess_helpers",
              "scheduling_review",
              "repertoire_snapshot",
              "background_activity",
              "background_metrics",
              "redis_runtime",
              "study_control",
              "repertoire_move_verification",
              "analysis_paste"
            ]
          }
        }
      }
    },
    "suites": {
      "type": "array"
    }
  }
}
