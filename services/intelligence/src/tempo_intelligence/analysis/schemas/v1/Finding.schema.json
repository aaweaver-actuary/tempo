      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4096,
      "title": "Evidence Ids",
      "type": "array"
    },
    "evidence_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Revision",
      "type": "string"
    },
    "evidence_status": {
      "enum": [
        "current",
        "stale",
        "partial",
        "unknown",
        "unavailable"
      ],
      "title": "Evidence Status",
      "type": "string"
    },
    "expected_moves": {
      "items": {
        "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
        "type": "string"
      },
      "title": "Expected Moves",
      "type": "array"
    },
    "finding_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Finding Id",
      "type": "string"
    },
    "finding_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Finding Revision",
      "type": "integer"
    },
    "gap_kind": {
      "anyOf": [
        {
          "enum": [
            "observed",
            "proactive"
