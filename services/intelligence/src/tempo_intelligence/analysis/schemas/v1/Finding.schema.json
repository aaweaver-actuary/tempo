{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "available"
      ],
      "title": "Action",
      "type": "object"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "activation_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Id"
        },
        "activation_revision": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Revision"
        },
        "activation_status": {
          "default": "unknown",
          "enum": [
            "activated",
            "unknown",
            "retired"
          ],
          "title": "Activation Status",
          "type": "string"
        },
        "publication_generation": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Generation"
        },
        "publication_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Id"
        },
        "serving_status": {
          "default": "unknown",
          "enum": [
            "current",
            "historical",
            "unknown"
          ],
          "title": "Serving Status",
          "type": "string"
        },
        "source_digest": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Digest",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "source_revision",
        "source_digest"
      ],
      "title": "Lineage",
      "type": "object"
    },
    "Representative": {
      "additionalProperties": false,
      "properties": {
        "actual_move": {
          "anyOf": [
            {
              "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual Move"
        },
        "fen": {
          "maxLength": 120,
          "title": "Fen",
          "type": "string"
        },
        "game_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Game Id"
        },
        "history": {
          "items": {
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "History",
          "type": "array"
        },
        "learner_color": {
          "enum": [
            "white",
            "black"
          ],
          "title": "Learner Color",
          "type": "string"
        },
        "learner_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learner Id"
        },
        "played_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Played At"
        },
        "ply": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ply"
        },
        "position_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Id"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_game_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Game Id"
        },
        "source_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Digest"
        },
        "source_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Source Revision",
          "type": "integer"
        },
        "starting_fen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starting Fen"
        },
        "workspace_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        }
      },
      "required": [
        "game_id",
        "source_revision",
        "fen",
        "actual_move",
        "learner_color"
      ],
      "title": "Representative",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "additionalProperties": {
        "$ref": "#/$defs/Action"
      },
      "title": "Actions",
      "type": "object"
    },
    "activation_status": {
      "enum": [
        "activated",
        "unknown",
        "retired"
      ],
      "title": "Activation Status",
      "type": "string"
    },
    "actual_frequency": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Frequency"
    },
    "card_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Card Id"
    },
    "category": {
      "enum": [
        "repertoire_miss",
        "practical_gap",
        "engine_opportunity"
      ],
      "title": "Category",
      "type": "string"
    },
    "decision_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Decision Id"
    },
    "delivery": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery"
    },
    "delivery_status": {
      "title": "Delivery Status",
      "type": "string"
    },
    "dismissal_state": {
      "enum": [
        "open",
        "dismissed"
      ],
      "title": "Dismissal State",
      "type": "string"
    },
    "eligible_encounter_games": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eligible Encounter Games"
    },
    "engine": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Engine"
    },
