    "input_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Input Id",
      "type": "string"
    },
    "input_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Input Revision",
      "type": "integer"
    },
    "learner_color": {
      "enum": [
        "white",
        "black"
      ],
      "title": "Learner Color",
      "type": "string"
    },
    "learning_settlement": {
      "const": "unknown",
