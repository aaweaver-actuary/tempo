    "opponent_move": {
      "anyOf": [
        {
          "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opponent Move"
    },
    "opponent_ply": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opponent Ply"
    },
    "policy_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policy Id"
    },
    "policy_version": {
      "const": "c-analysis-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "proposal_anchor": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Anchor"
    },
    "proposal_cost": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Cost"
    },
    "proposal_status": {
      "const": "not_created",
      "title": "Proposal Status",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "related_findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Related Findings",
      "type": "array"
    },
    "repertoire_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Repertoire Id"
    },
    "representative": {
      "$ref": "#/$defs/Representative"
    },
    "response_proposal": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Proposal"
    },
    "route_ids": {
      "anyOf": [
        {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route Ids"
    },
    "scope_revision": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Revision"
    },
    "source_evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Source Evidence",
      "type": "array"
    },
    "supporting_game_count": {
      "minimum": 0,
      "title": "Supporting Game Count",
      "type": "integer"
    },
    "supporting_games": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Supporting Games",
      "type": "array"
    },
    "uncertainty": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainty",
      "type": "array"
    },
    "workspace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "finding_revision",
    "evidence_revision",
    "category",
    "policy_version",
    "workspace_id",
    "repertoire_id",
    "policy_id",
    "learner_color",
    "lineage",
    "representative",
    "incident_id",
    "supporting_games",
    "supporting_game_count",
    "evidence_ids",
    "evidence_status",
    "reason_codes",
    "uncertainty",
    "expected_moves",
    "card_id",
    "decision_id",
    "engine",
    "gap_kind",
    "source_evidence",
    "delivery_status",
    "learning_settlement",
    "activation_status",
    "proposal_status",
    "dismissal_state",
    "actions",
    "input_id",
    "input_revision"
