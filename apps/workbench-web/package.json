{
  "name": "@tempo/workbench-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "dist",
    "lib"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/public-build-config.mjs && npm run build && node test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.1.1",
    "chess.js": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
