FROM node:22-slim
WORKDIR /app
COPY package.json ./package.json
COPY scripts/defense-engine-worker.mjs ./scripts/defense-engine-worker.mjs
COPY scripts/maia-coverage-client.mjs ./scripts/maia-coverage-client.mjs
COPY scripts/durable-engine-request.mjs ./scripts/durable-engine-request.mjs
COPY public/engines/sf_19_smallnet.js public/engines/sf_19_smallnet.wasm public/engines/nn-61e7af4bb97d.nnue ./public/engines/
CMD ["node", "scripts/defense-engine-worker.mjs"]
