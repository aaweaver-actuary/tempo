{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:local": "TEMPO_TARGET=local vite --config vite.static.config.ts",
    "build": "vinext build",
    "build:wasm": "wasm-pack build tempo-core --target web --out-dir ../public/tempo-core --release",
    "build:static": "npm run build:wasm && vite build --config vite.static.config.ts",
    "build:local": "TEMPO_TARGET=local vite build --config vite.static.config.ts",
    "test": "node scripts/test-all.mjs",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:docker": "node scripts/test-docker.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "preview:static": "vite preview --config vite.static.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "verify:static": "node scripts/verify-static-build.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern pages-dist --ignore-pattern local-dist --ignore-pattern public/tempo-core --ignore-pattern test-results --ignore-pattern playwright-report",
    "test:visual": "node scripts/test-visual.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "@lichess-org/stockfish-web": "^0.5.0",
    "chess.js": "^1.4.0",
    "next": "16.2.6",
    "onnxruntime-web": "^1.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "^5.0.1",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
